# Copy these into Vercel > Settings > Environment Variables.
# NEVER commit real values to GitHub.

# ── Database (Neon) ─────────────────────────────────────────────
# Pooled connection string (host contains "-pooler"). Add ?pgbouncer=true&connect_timeout=15
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection string (NO "-pooler" in the host). Used only for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── First-time setup (Phase 1) ──────────────────────────────────
# A long random value (16+ characters). You type it on the /setup page once.
SETUP_TOKEN=""
# The first Super Admin account that /setup will create.
SUPER_ADMIN_NAME="Your Name"
SUPER_ADMIN_EMAIL="you@example.com"
SUPER_ADMIN_PASSWORD="use-a-long-unique-password"

# ── Sign-in (Phase 2) ───────────────────────────────────────────
# A long random value (40+ characters). Signs login sessions. Keep it private.
AUTH_SECRET=""

# ── Added in later phases ───────────────────────────────────────
# Result PINs (Phase 7)
PIN_PEPPER=""                          # REQUIRED: random, 40+ characters. Never change it later.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""      # optional bot check
TURNSTILE_SECRET_KEY=""                # optional bot check
